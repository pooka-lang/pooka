//// A lockfile is a receipt for the choices already made.
////
//// Render and validate resolved package versions and source identities. Local
//// paths are recorded relative to the project so moving the checkout does not
//// invent a new dependency.
////
//// ```text
//// manifest constraints -> chosen sources -> reproducible lock entries
//// ```

// SPDX-License-Identifier: Apache-2.0

import filepath
import gleam/dict.{type Dict}
import gleam/json
import gleam/list
import gleam/result
import gleam/string
import project/dependency as d
import project/project.{type Project}
import project/project_error.{type ProjectError, DependencyProblem}
import project/project_name
import simplifile
import tom

pub type Locked {
  Locked(
    name: String,
    version: String,
    path: String,
    origin: d.Origin,
    kind: d.Kind,
    dependencies: List(d.Dependency),
    names: List(String),
  )
}

pub fn write(
  root: Project,
  packages: List(Project),
) -> Result(Nil, ProjectError) {
  use old <- result.try(read(root))
  let current =
    list.filter(packages, fn(p) { p.name != root.name })
    |> list.map(fn(p) {
      let entry = from_project(p)
      Locked(
        ..entry,
        names: list.filter(entry.names, fn(name) {
          list.any(packages, fn(p) { p.name == name })
        }),
      )
    })
  let all =
    list.append(
      current,
      list.filter(old, fn(p) { !list.any(current, fn(n) { n.name == p.name }) }),
    )
  let names =
    reachable(
      list.append(root.dependencies, root.dev_dependencies)
        |> list.filter(fn(dep) {
          case dep {
            d.Hex(_, _, True) -> False
            _ -> True
          }
        })
        |> list.map(fn(dep) { dep.name }),
      all,
      [],
    )
  let selected =
    list.filter(all, fn(p) { list.contains(names, p.name) })
    |> list.sort(fn(a, b) { string.compare(a.name, b.name) })
  let path = filepath.join(root.root, "pooka.lock")
  case
    selected,
    root.dependencies,
    root.dev_dependencies,
    simplifile.is_file(path)
  {
    [], [], [], Ok(False) -> Ok(Nil)
    _, _, _, _ ->
      atomic(path, render_entries(root, selected))
      |> result.map_error(DependencyProblem(path, _))
  }
}

fn reachable(
  pending: List(String),
  entries: List(Locked),
  seen: List(String),
) -> List(String) {
  case pending {
    [] -> seen
    [name, ..rest] ->
      case list.contains(seen, name) {
        True -> reachable(rest, entries, seen)
        False -> {
          let children =
            list.find(entries, fn(p) { p.name == name })
            |> result.map(fn(p) { p.names })
            |> result.unwrap([])
          reachable(list.append(children, rest), entries, [name, ..seen])
        }
      }
  }
}

fn from_project(p: Project) -> Locked {
  Locked(
    p.name,
    p.version,
    p.root,
    p.origin,
    p.kind,
    p.dependencies,
    list.map(p.dependencies, fn(dep) { dep.name }),
  )
}

pub fn render(root: Project, packages: List(Project)) -> String {
  render_entries(root, list.map(packages, from_project))
}

fn render_entries(root: Project, packages: List(Locked)) -> String {
  "# Generated by Pooka. Local trees stay live; remote sources are pinned.\nversion = 1\n\n[requirements]\n"
  <> requirements(root.dependencies)
  <> "\n[dev-requirements]\n"
  <> requirements(root.dev_dependencies)
  <> {
    packages
    |> list.map(fn(p) {
      "\n[[packages]]\nname = "
      <> quoted(p.name)
      <> "\nversion = "
      <> quoted(p.version)
      <> "\n"
      <> case p.origin {
        d.LocalOrigin ->
          "path = " <> quoted(relative(root.root, p.path)) <> "\n"
        d.GitOrigin(url, reference, revision) ->
          "git = "
          <> quoted(portable_url(root.root, url))
          <> "\nreference = "
          <> quoted(reference)
          <> "\nrevision = "
          <> quoted(revision)
          <> "\n"
        d.HexOrigin(checksum) -> "checksum = " <> quoted(checksum) <> "\n"
      }
      <> case p.kind {
        d.Pooka -> ""
        d.Beam(app, tools) ->
          "application = "
          <> quoted(app)
          <> "\nbuild_tools = ["
          <> join_strings(tools)
          <> "]\n"
      }
      <> "dependencies = ["
      <> join_strings(p.names)
      <> "]\nrequirements = { "
      <> {
        p.dependencies
        |> list.map(fn(dep) { dep.name <> " = " <> declaration(dep) })
        |> string.join(", ")
      }
      <> " }\n"
    })
    |> string.concat
  }
}

fn join_strings(values: List(String)) -> String {
  values |> list.map(quoted) |> string.join(", ")
}

fn requirements(deps: List(d.Dependency)) -> String {
  deps
  |> list.map(fn(dep) { dep.name <> " = " <> declaration(dep) <> "\n" })
  |> string.concat
}

fn declaration(dep: d.Dependency) -> String {
  case dep {
    d.Local(_, path) -> "{ path = " <> quoted(path) <> " }"
    d.Hex(_, requirement, optional) ->
      case optional {
        False -> quoted(requirement)
        True -> "{ version = " <> quoted(requirement) <> ", optional = true }"
      }
    d.Git(_, url, reference) ->
      "{ git = "
      <> quoted(url)
      <> case string.split_once(reference, ":") {
        Ok(#(kind, value)) -> ", " <> kind <> " = " <> quoted(value) <> " }"
        Error(_) -> " }"
      }
  }
}

fn portable_url(root: String, url: String) -> String {
  case filepath.is_absolute(url) {
    True -> relative(root, url)
    False -> url
  }
}

fn quoted(value: String) -> String {
  json.string(value) |> json.to_string
}

pub fn relative(root: String, path: String) -> String {
  relative_parts(
    list.filter(string.split(root, "/"), fn(x) { x != "" }),
    list.filter(string.split(path, "/"), fn(x) { x != "" }),
  )
}

fn relative_parts(root: List(String), path: List(String)) -> String {
  case root, path {
    [a, ..aa], [b, ..bb] if a == b -> relative_parts(aa, bb)
    [], [] -> "."
    _, _ -> string.join(list.append(list.map(root, fn(_) { ".." }), path), "/")
  }
}

pub fn validate(root: Project) -> Result(Nil, ProjectError) {
  read(root) |> result.map(fn(_) { Nil })
}

pub fn read(root: Project) -> Result(List(Locked), ProjectError) {
  let path = filepath.join(root.root, "pooka.lock")
  let invalid = fn() {
    DependencyProblem(
      path,
      "Invalid or unsupported lockfile. Expected lockfile version 1 and valid source records.",
    )
  }
  case simplifile.read(path) {
    Error(simplifile.Enoent) -> Ok([])
    Error(error) ->
      Error(DependencyProblem(path, simplifile.describe_error(error)))
    Ok(text) -> {
      use config <- result.try(
        tom.parse(text) |> result.map_error(fn(_) { invalid() }),
      )
      use Nil <- result.try(case tom.get_int(config, ["version"]) {
        Ok(1) -> Ok(Nil)
        _ -> Error(invalid())
      })
      use _ <- result.try(d.parse(config, "requirements", path))
      use _ <- result.try(d.parse(config, "dev-requirements", path))
      use tables <- result.try(case dict.get(config, "packages") {
        Error(_) -> Ok([])
        Ok(tom.ArrayOfTables(tables)) -> Ok(tables)
        _ -> Error(invalid())
      })
      use entries <- result.try(
        list.try_map(tables, fn(table) { parse_entry(root, table, path) }),
      )
      case
        list.length(entries)
        == list.length(list.unique(list.map(entries, fn(p) { p.name })))
      {
        True -> Ok(entries)
        False -> Error(invalid())
      }
    }
  }
}

fn parse_entry(
  root: Project,
  table: Dict(String, tom.Toml),
  path: String,
) -> Result(Locked, ProjectError) {
  let invalid = fn() {
    DependencyProblem(path, "Invalid locked package record.")
  }
  use name <- result.try(
    tom.get_string(table, ["name"]) |> result.map_error(fn(_) { invalid() }),
  )
  use Nil <- result.try(
    project_name.validate(name) |> result.map_error(fn(_) { invalid() }),
  )
  use version <- result.try(
    tom.get_string(table, ["version"]) |> result.map_error(fn(_) { invalid() }),
  )
  use names <- result.try(
    strings(table, "dependencies") |> result.map_error(fn(_) { invalid() }),
  )
  use dependencies <- result.try(d.parse(table, "requirements", path))
  use #(source, origin) <- result.try(
    case
      tom.get_string(table, ["path"]),
      tom.get_string(table, ["git"]),
      tom.get_string(table, ["checksum"])
    {
      Ok(source), Error(_), Error(_) if source != "" ->
        Ok(#(filepath.join(root.root, source), d.LocalOrigin))
      Error(_), Ok(url), Error(_) if url != "" -> {
        use reference <- result.try(
          tom.get_string(table, ["reference"])
          |> result.map_error(fn(_) { invalid() }),
        )
        use revision <- result.try(
          tom.get_string(table, ["revision"])
          |> result.map_error(fn(_) { invalid() }),
        )
        use Nil <- result.try(case hash(revision, 40) || hash(revision, 64) {
          True -> Ok(Nil)
          False -> Error(invalid())
        })
        Ok(#("", d.GitOrigin(url, reference, string.lowercase(revision))))
      }
      Error(_), Error(_), Ok(checksum) ->
        case hash(checksum, 64) {
          True -> Ok(#("", d.HexOrigin(string.lowercase(checksum))))
          False -> Error(invalid())
        }
      _, _, _ -> Error(invalid())
    },
  )
  use kind <- result.try(case dict.get(table, "application") {
    Error(_) -> Ok(d.Pooka)
    Ok(tom.String(app)) -> {
      use Nil <- result.try(
        project_name.validate(app) |> result.map_error(fn(_) { invalid() }),
      )
      use tools <- result.try(
        strings(table, "build_tools") |> result.map_error(fn(_) { invalid() }),
      )
      Ok(d.Beam(app, tools))
    }
    _ -> Error(invalid())
  })
  Ok(Locked(name, version, source, origin, kind, dependencies, names))
}

fn strings(
  table: Dict(String, tom.Toml),
  key: String,
) -> Result(List(String), Nil) {
  use values <- result.try(
    tom.get_array(table, [key]) |> result.map_error(fn(_) { Nil }),
  )
  list.try_map(values, fn(value) {
    case value {
      tom.String(value) -> Ok(value)
      _ -> Error(Nil)
    }
  })
}

pub fn hash(value: String, length: Int) -> Bool {
  string.length(value) == length
  && list.all(string.to_graphemes(value), fn(c) {
    string.contains("0123456789abcdefABCDEF", c)
  })
}

@external(erlang, "pooka_package_ffi", "write_atomic")
fn atomic(path: String, text: String) -> Result(Nil, String)
