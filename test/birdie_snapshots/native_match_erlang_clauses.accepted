---
version: 2.0.2
title: native match erlang clauses
---
-module(pooka@app@main).
-file("src/main.pooka", 1).
-export([read/1,first/1]).
read(M0) ->
    begin
        begin
            M1 = M0,
            case M1 of
                <<13,10,M2/binary>> ->
                    begin
                        M3 = M2,
                        read(M3)
                    end;
                <<_,M4/binary>> ->
                    begin
                        M5 = 1,
                        M7 =
                            begin
                                M6 = M4,
                                read(M6)
                            end,
                        M5 + M7
                    end;
                <<>> ->
                    0;
                _ ->
                    -1
            end
        end
    end.
first(M9) ->
    begin
        begin
            M10 = M9,
            case M10 of
                [M11 | M12] ->
                    M11;
                [] ->
                    0;
                _ ->
                    error(pooka_match_failure)
            end
        end
    end.

