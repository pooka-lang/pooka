//// A messy file.
module main

import io

class Animal {
  let name: String

  new(name) {
    self.name = name
  }

  speak() -> String {
    "..."
  }
}

main() {
  let a = Animal("Rex")
  match a {
    Animal(n) -> io.println(n)
  }
}

