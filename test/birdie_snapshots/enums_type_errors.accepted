Source:
module main
enum Severity {
  Error
  Warning
  Notice
}
describe(severity: Severity) -> String {
  match severity {
    Severity.Error -> "error"
    Severity.Warning -> "warning"
  }
}
main() {
  let a = Severity.Eror
  let b = Severity.Error()
  let c = Severity
  describe(Severity.Notice)
}

