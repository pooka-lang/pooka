      "class Box(a) {\n  let value: a\n  new(value) { self.value = value }\n}\n",
    )
  assert list.map(value.type_parameters, fn(name) { name.name }) == ["a"]
  assert fields(value) == ["value: a"]
}

pub fn several_ordinary_type_parameters_test() {
  let value = class("class Pair(a, b) {}\n")
  assert list.map(value.type_parameters, fn(name) { name.name }) == ["a", "b"]
  assert value.members == []
}

pub fn documentation_is_kept_test() {
  let value = class("/// A point.\nclass Point(x: Float, y: Float)\n")
  assert value.documentation == [" A point."]
}

pub fn documented_fields_test() {
  let value =
    class(
      "class Point(\n  /// Across.\n  x: Float,\n  /// Down.\n  y: Float,\n)\n",
    )
  assert fields(value) == ["x: Float", "y: Float"]
}

// A generated constructor has no handwritten body to underline. Its members
// must point back to the concise fields that caused them to exist.
pub fn generated_member_spans_point_at_the_fields_test() {
  let source = "module main\nclass Point(x: Float, y: Float)\n"
  let module = support.parse(source)
  let assert [ast.ClassDeclaration(value)] = module.declarations
  let spans =
    list.filter_map(value.members, fn(member) {
      case member {
        ast.FieldMember(field) -> Ok(support.text_at(source, field.name.span))
        _ -> Error(Nil)
      }
    })
  assert spans == ["x", "y"]
}

pub fn a_field_without_a_type_is_reported_test() {
  assert front("class User(name: String, age)\n")
    == ["parse.concise_field_type"]
}

pub fn the_missing_type_span_is_the_field_test() {
  let source = "module main\nclass User(name: String, age)\n"
  let assert [parse_error.ConciseFieldType(field: span, name: "age")] =
    support.parse_errors(source)
  assert support.text_at(source, span) == "age"
}

pub fn a_field_without_a_type_is_still_generated_test() {
  let module =
    support.parse_module_with_errors(
      "module main\nclass User(name: String, age)\n",
    )
  let assert [ast.ClassDeclaration(value)] = module.declarations
  assert list.length(constructors(value)) == 1
  let assert [_, _] =
    list.filter(value.members, fn(member) {
      case member {
        ast.FieldMember(_) -> True
        _ -> False
      }
    })
}

pub fn an_explicit_constructor_is_reported_test() {
  assert front(
      "class User(name: String, age: Int) {\n  new(name, age) {\n    self.name = name\n    self.age = age\n  }\n}\n",
    )
    == ["parse.concise_constructor"]
}

pub fn an_explicit_constructor_without_parameters_is_reported_test() {
  assert front("class P(x: Int) { new() { 1 } }\n")
    == ["parse.concise_constructor"]
}

pub fn the_constructor_span_covers_it_test() {
  let source = "module main\nclass P(x: Int) {\n  new(x) {\n    1\n  }\n}\n"
  let assert [
    parse_error.ConciseConstructor(constructor: span, class_name: "P"),
  ] = support.parse_errors(source)
  assert support.text_at(source, span) == "new(x) {\n    1\n  }"
}

