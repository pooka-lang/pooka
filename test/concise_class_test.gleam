pub fn construction_has_the_class_type_test() {
  assert type_of(
      "class Point(x: Float, y: Float)\nmain() { Point(1.0, 2.0) }\n",
      "main",
    )
    == "fn() -> main.Point"
}

pub fn fields_have_their_declared_types_test() {
  assert type_of(
      "class User(name: String, age: Int)\nname(user: User) { user.name }\n",
      "name",
    )
    == "fn(main.User) -> String"
  assert type_of(
      "class User(name: String, age: Int)\nage(user: User) { user.age }\n",
      "age",
    )
    == "fn(main.User) -> Int"
}

pub fn the_constructor_checks_argument_types_test() {
  assert types("class P(x: Int)\nmain() { P(\"a\") }\n") == ["type.unification"]
}

pub fn the_constructor_checks_the_argument_count_test() {
  assert types("class P(x: Int)\nmain() { P(1, 2) }\n") == ["type.unification"]
  assert types("class P(x: Int)\nmain() { P() }\n") == ["type.unification"]
}

pub fn unknown_fields_are_reported_test() {
  assert types("class P(x: Int)\nmain() { P(1).z }\n")
    == ["type.unknown_member"]
}

pub fn generic_concise_classes_are_instantiated_test() {
  assert types(
      "class Pair(first: a, second: b)\nmain() -> Pair(Int, String) { Pair(1, \"one\") }\n",
    )
    == []
  assert types(
      "class Pair(first: a, second: b)\nmain() -> Pair(Int, String) { Pair(\"one\", 1) }\n",
    )
    == ["type.unification"]
  assert type_of(
      "class Pair(first: a, second: b)\nmain() { Pair(1, \"one\").second }\n",
      "main",
    )
    == "fn() -> String"
}

pub fn methods_use_the_generated_fields_test() {
