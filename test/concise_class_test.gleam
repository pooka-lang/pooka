      "class Expression {}\nclass IntLiteral(value: String) is Expression\nclass Variable(name: String) is Expression\nall() -> List(Expression) { [IntLiteral(\"1\"), Variable(\"x\")] }\n",
    )
    == []
}

pub fn concise_classes_implement_interfaces_test() {
  assert types(
      "interface Shape { area() -> Float }\nclass Square(side: Float) with Shape {\n  area() -> Float { side * side }\n}\nmain() -> Shape { Square(2.0) }\n",
    )
    == []
  assert types(
      "interface Shape { area() -> Float }\nclass Square(side: Float) with Shape\n",
    )
    == ["type.missing_interface_method"]
}

pub fn class_patterns_destructure_the_fields_test() {
  assert type_of(
      "class User(name: String, age: Int)\nage(user: User) {\n  match user {\n    User(_, age) -> age\n  }\n}\n",
      "age",
    )
    == "fn(main.User) -> Int"
}

pub fn class_patterns_check_the_field_count_test() {
  assert types(
      "class User(name: String, age: Int)\nf(user: User) {\n  match user {\n    User(name) -> name\n  }\n}\n",
    )
