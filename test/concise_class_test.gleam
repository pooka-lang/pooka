//// A short declaration still owes the full class promises.
////
//// Inspect the fields, constructor and type parameters generated by concise
//// class syntax, then check and run the result. Generated members need useful
//// source spans, and the shorter spelling must preserve ordinary class rules
//// for inheritance, interfaces, matching and structural equality.
////
//// ```pooka
//// class Point(x: Int, y: Int)
//// main() { Point(3, 7).x }
//// ```

import birdie
import cli/command
import compiler/parser/ast
import compiler/parser/parse_error
import compiler/typesystem/module_infer
import compiler/typesystem/monotype
import compiler/typesystem/unify
import gleam/dict
import gleam/list
import gleam/option.{None, Some}
import gleam/string
import support

fn class(source: String) -> ast.Class {
  let module = support.parse("module main\n" <> source)
  let assert [ast.ClassDeclaration(value), ..] = module.declarations
  value
}

fn fields(value: ast.Class) -> List(String) {
  list.filter_map(value.members, fn(member) {
    case member {
      ast.FieldMember(field) -> {
        let assert Some(annotation) = field.annotation
        Ok(field.name.name <> ": " <> annotation_text(annotation))
      }
      _ -> Error(Nil)
    }
  })
}

fn annotation_text(annotation: ast.TypeAnnotation) -> String {
  case annotation {
    ast.NamedType(None, name, [], _) -> name
    ast.NamedType(None, name, arguments, _) ->
      name
      <> "("
      <> string.join(list.map(arguments, annotation_text), ", ")
      <> ")"
    ast.NamedType(Some(module), name, _, _) -> module <> "." <> name
    ast.TypeVariable(name, _) -> name
    _ -> "?"
  }
}

fn constructors(value: ast.Class) -> List(ast.Constructor) {
  list.filter_map(value.members, fn(member) {
    case member {
      ast.ConstructorMember(constructor) -> Ok(constructor)
      _ -> Error(Nil)
    }
  })
}

fn front(body: String) -> List(String) {
  support.diagnostic_ids("module main\n" <> body)
}

fn check(body: String) -> module_infer.Module {
  let assert Ok(report) =
    module_infer.infer(
      support.parse("module main\n" <> body),
      dict.new(),
      unify.new(),
      support.path,
    )
  report
}

fn types(body: String) -> List(String) {
  check(body).diagnostics |> list.map(fn(value) { value.id })
}

fn type_of(body: String, name: String) -> String {
  let report = check(body)
  let assert Ok(function) =
    list.find(report.functions, fn(function) { function.name.name == name })
  monotype.to_string(unify.apply(function.type_, report.state))
}

fn output(name: String, body: String) -> String {
  use directory <- support.with_directory(name)
  support.write(
    directory <> "/pooka.toml",
    "name = \"app\"\nversion = \"0.1.0\"\n",
  )
  support.write(directory <> "/src/main.pooka", "module main\n" <> body)
  let outcome = support.cli_main(["run"], command.plain(directory))
  assert support.diagnostics(outcome.stderr) == ""
  assert outcome.status == 0
  outcome.stdout
}

// The short spelling generates ordinary immutable fields. Inspect the AST
// before relying on later inference to reveal a desugaring mistake.
pub fn fields_become_immutable_fields_test() {
  let value = class("class Point(x: Float, y: Float)\n")
  assert fields(value) == ["x: Float", "y: Float"]
  list.each(value.members, fn(member) {
    case member {
      ast.FieldMember(field) -> {
        assert field.mutability == ast.Immutable
        assert field.value == None
      }
      _ -> Nil
    }
  })
}

pub fn a_constructor_is_generated_test() {
  let value = class("class Point(x: Float, y: Float)\n")
  let assert [constructor] = constructors(value)
  assert list.map(constructor.parameters, fn(parameter) {
      let assert ast.NamedParameter(name) = parameter.name
      name
    })
    == ["x", "y"]
}

pub fn the_constructor_assigns_each_field_in_order_test() {
  let value = class("class User(name: String, age: Int)\n")
  let assert [constructor] = constructors(value)
  let assigned =
    list.map(constructor.body.statements, fn(statement) {
      let assert ast.ExpressionStatement(ast.Assignment(
        ast.AssignField(ast.SelfExpression(_), field, _),
        ast.Assign,
        ast.Variable(parameter, _),
        _,
      )) = statement
      #(field.name, parameter)
    })
  assert assigned == [#("name", "name"), #("age", "age")]
}

pub fn a_single_field_test() {
  assert fields(class("class Name(value: String)\n")) == ["value: String"]
}

pub fn many_fields_test() {
  let names = ["a", "b", "c", "d", "e", "f", "g", "h"]
  let source =
    "class Wide("
    <> string.join(list.map(names, fn(name) { name <> ": Int" }), ", ")
    <> ")\n"
  assert fields(class(source)) == list.map(names, fn(name) { name <> ": Int" })
}

pub fn fields_over_several_lines_with_a_trailing_comma_test() {
  assert fields(class("class User(\n  name: String,\n  age: Int,\n)\n"))
    == ["name: String", "age: Int"]
}

pub fn generic_and_qualified_field_types_test() {
  assert fields(class(
      "class Call(callee: Expression, arguments: List(Expression), span: location.Span)\n",
    ))
    == [
      "callee: Expression",
      "arguments: List(Expression)",
      "span: location.Span",
    ]
}

pub fn the_body_is_optional_test() {
  let module =
    support.parse(
      "module main\nclass Point(x: Float, y: Float)\nclass Next {}\nmain() { 1 }\n",
    )
  let assert [
    ast.ClassDeclaration(point),
    ast.ClassDeclaration(next),
    ast.FunctionDeclaration(_),
  ] = module.declarations
  assert point.name.name == "Point"
  assert next.name.name == "Next"
}

pub fn the_class_span_ends_after_the_fields_without_a_body_test() {
  let source = "module main\nclass Point(x: Float, y: Float)\n"
  let module = support.parse(source)
  let assert [ast.ClassDeclaration(value)] = module.declarations
  assert support.text_at(source, value.span)
    == "class Point(x: Float, y: Float)"
}

pub fn a_body_adds_methods_test() {
  let value =
    class("class Point(x: Float, y: Float) {\n  sum() -> Float { x + y }\n}\n")
  assert fields(value) == ["x: Float", "y: Float"]
  let methods =
    list.filter_map(value.members, fn(member) {
      case member {
        ast.MethodMember(method) -> Ok(method.name.name)
        _ -> Error(Nil)
      }
    })
  assert methods == ["sum"]
  assert list.length(constructors(value)) == 1
}

pub fn a_body_adds_other_fields_test() {
  let value = class("class Counter(start: Int) {\n  let step: Int = 1\n}\n")
  assert fields(value) == ["start: Int", "step: Int"]
}

pub fn a_superclass_without_a_body_test() {
  let value = class("class IntLiteral(value: String) is Expression\n")
  let assert Some(ast.NamedType(None, "Expression", [], _)) = value.superclass
  assert fields(value) == ["value: String"]
}

pub fn a_superclass_with_a_body_test() {
  let value =
    class("class Circle(radius: Float) is Shape {\n  area() { 1 }\n}\n")
  let assert Some(ast.NamedType(None, "Shape", [], _)) = value.superclass
}

pub fn interfaces_test() {
  let value = class("class Square(side: Float) with Shape, Show\n")
  assert list.length(value.interfaces) == 2
}

pub fn a_generic_superclass_test() {
  let value = class("class Full(value: a) is Box(a)\n")
  let assert Some(ast.NamedType(None, "Box", [ast.TypeVariable("a", _)], _)) =
    value.superclass
  assert list.map(value.type_parameters, fn(name) { name.name }) == ["a"]
}

pub fn type_parameters_come_from_the_fields_test() {
  let value = class("class Pair(first: a, second: b)\n")
  assert list.map(value.type_parameters, fn(name) { name.name }) == ["a", "b"]
}

