// The runtime comparison complements the inferred-interface comparison above.
// Two matching types could still conceal different generated field order or
// initialization.
pub fn concise_and_full_classes_run_the_same_test() {
  let program = "main() {\n  let p = Point(3, 4)\n  echo #(p, p.x, p.y)\n}\n"
  let concise =
    output("concise_equivalent_a", "class Point(x: Int, y: Int)\n" <> program)
  let full =
    output(
      "concise_equivalent_b",
      "class Point {\n  let x: Int\n  let y: Int\n  new(x, y) {\n    self.x = x\n    self.y = y\n  }\n}\n"
        <> program,
    )
  assert concise == full
  assert concise == "#(Point(3, 4), 3, 4)\n"
}
