pub fn closed_hierarchies_are_exhaustive_test() {
  let hierarchy =
    "class Expression {}\nclass IntLiteral(value: String) is Expression\nclass Variable(name: String) is Expression\nclass Call(callee: Expression, arguments: List(Expression)) is Expression\n"
  assert types(
      hierarchy
      <> "describe(e: Expression) -> String {\n  match e {\n    IntLiteral(value) -> value\n    Variable(name) -> name\n    Call(_, _) -> \"call\"\n  }\n}\n",
    )
    == []
}

pub fn a_missing_subclass_is_reported_test() {
  let hierarchy =
    "class Expression {}\nclass IntLiteral(value: String) is Expression\nclass Variable(name: String) is Expression\n"
  let report =
    check(
      hierarchy
      <> "describe(e: Expression) -> String {\n  match e {\n    IntLiteral(value) -> value\n  }\n}\n",
    )
  let assert [found] = report.diagnostics
  assert found.id == "type.non_exhaustive_match"
}

pub fn concise_classes_with_enum_fields_test() {
  assert types(
      "enum Kind { Int, Name }\nclass Token(kind: Kind, text: String)\nis_int(token: Token) {\n  match token {\n    Token(Kind.Int, _) -> True\n    Token(Kind.Name, _) -> False\n  }\n}\n",
    )
    == []
}

// Use the long spelling as a second route to the same inferred interface. The
// convenience syntax must not introduce a separate set of class semantics.
pub fn concise_and_full_classes_are_equivalent_test() {
  let concise = "class Point(x: Float, y: Float)\n"
  let full =
    "class Point {\n  let x: Float\n  let y: Float\n  new(x, y) {\n    self.x = x\n    self.y = y\n  }\n}\n"
  let program = "main() { Point(1.0, 2.0).y }\n"
  assert type_of(concise <> program, "main") == type_of(full <> program, "main")
}

